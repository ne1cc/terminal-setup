#!/usr/bin/env bash
# gh-ns-clone — clone owner/repo into ~/Github/<owner>/<repo> (namespace pattern)
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: gh-ns-clone <owner>/<repo> [gh repo clone args...]" >&2
  exit 2
fi

spec="$1"; shift
# Strip common GitHub URL schemes and suffixes
spec="${spec#https://github.com/}"
spec="${spec#http://github.com/}"
spec="${spec#git@github.com:}"
spec="${spec#ssh://git@github.com/}"
spec="${spec%.git}"
spec="${spec%/}"

owner="${spec%%/*}"
repo="${spec#*/}"
if [[ -z "$owner" || -z "$repo" || "$owner" == "$spec" ]]; then
  echo "error: expected owner/repo or github url, got '$spec'" >&2
  exit 2
fi

dest="${GITHUB_ROOT:-$HOME/Github}/$owner/$repo"
if [[ -d "$dest/.git" ]]; then
  echo "already cloned: $dest"
  exit 0
fi

mkdir -p "$(dirname "$dest")"
echo "Cloning $spec → $dest"
if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
  exec gh repo clone "$spec" "$dest" "$@"
else
  exec git clone "https://github.com/$owner/$repo.git" "$dest" "$@"
fi

#!/usr/bin/env bash
# tmux-sessionizer — ~/Github/<owner>/<repo> + ~/Github/_local/projects/<name>
set -euo pipefail

GITHUB_ROOT="${GITHUB_ROOT:-$HOME/Github}"

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(
      {
        find "$GITHUB_ROOT" -mindepth 2 -maxdepth 2 -type d \
          ! -path "$GITHUB_ROOT/_local/*" \
          ! -path "$GITHUB_ROOT/_*" \
          ! -path '*/.*' 2>/dev/null
        find "$GITHUB_ROOT/_local/projects" -mindepth 1 -maxdepth 1 -type d 2>/dev/null
      } | LC_ALL=C sort | fzf --prompt='repo > '
    )
fi

[[ -z ${selected:-} ]] && exit 0

rel="${selected#"$GITHUB_ROOT"/}"
selected_name=$(printf '%s' "$rel" | tr '/.' '__')
tmux_running=$(pgrep tmux || true)

if [[ -z ${TMUX:-} && -z ${tmux_running:-} ]]; then
    tmux new-session -s "$selected_name" -c "$selected"
    exit 0
fi

if ! tmux has-session -t="$selected_name" 2>/dev/null; then
    tmux new-session -ds "$selected_name" -c "$selected"
fi

if [[ -z ${TMUX:-} ]]; then
    tmux attach-session -t="$selected_name"
else
    tmux switch-client -t="$selected_name"
fi

# First terminal surface creates/attaches to the persistent 'main' session:
initial-command = tmux new-session -A -s main

# Subsequent surfaces (Cmd+N, new windows) launch a brand new tmux session:
# Optional: auto-spawn tmux on launch (set your absolute install path)
# command = /Users/YOU/bin/ghostty-new-session

# Send explicit CSI extended key escape sequences to tmux for Ctrl+Tab and Ctrl+Shift+Tab
keybind = ctrl+tab=text:\x1b[27;5;9~
keybind = ctrl+shift+tab=text:\x1b[27;6;9~
keybind = ctrl+shift+h=text:\x1b[27;6;72~
keybind = ctrl+shift+l=text:\x1b[27;6;76~

# Ghostty split shortcuts
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+h=goto_split:left
keybind = super+l=goto_split:right
keybind = super+k=goto_split:top
keybind = super+j=goto_split:bottom

# Map preferred keys to Ghostty's native tab actions (Show Next Tab / Show Previous Tab)
keybind = super+shift+]=next_tab
keybind = super+shift+[=previous_tab

# Background transparency and glass blur effect
background-opacity = 0.85
background-blur = true

# Font configuration
font-size = 15

